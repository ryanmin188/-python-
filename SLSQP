import numpy as np
from scipy.optimize import minimize

# =========================================================================
# 一、 第三问物理及环境参数设定 (环境温度 80ºC, 30分钟)
# =========================================================================
T_env = 80.0
T_body = 37.0
T0 = 37.0

# 刚性固定层厚度 (单位: m)
d1 = 0.0006
d3 = 0.0036

# 各层热物性参数: [I层, II层, III层, IV层]
rho = [300.0, 862.0, 74.2, 1.18]
cp = [1377.0, 2100.0, 1726.0, 1005.0]
kmat = [0.082, 0.37, 0.045, 0.028]

# 表面对流换热系数
h1 = 113.0
h4 = 8.344

# 决策变量搜索上下限 (单层限制: 0.6mm 到 25mm)
d_min_layer = 0.0006
d_max_1_layer = 0.0250
d_max_2_layer = 0.0064

# 舒适度归一化所用的全局空间边界 (1.2mm 到 50mm)
L_min = 0.0012
L_max = 0.0314

# 效用函数权重系数 (舒适度 C 与 隔热 R 平分秋色，可根据论文主观调整)
alpha_pref = 0.5

# 数值计算步长
dt = 1.0
t_end = 30 * 60  # 30分钟 = 1800秒
Nt = int(t_end / dt)
Nx = 220


# =========================================================================
# 二、 底层物理引擎：一维非稳态热传导 PDE 求解器 (动态适应 d2 和 d4)
# =========================================================================
def solve_temperature_3(d2, d4):
    """
    完全保留你组的一维有限差分隐式求解器逻辑，提供底层物理仿真
    """
    L = d1 + d2 + d3 + d4
    dx = L / Nx
    x = np.linspace(0, L, Nx + 1)

    rho_arr = np.zeros(Nx + 1)
    cp_arr = np.zeros(Nx + 1)
    k_arr = np.zeros(Nx + 1)

    for i in range(Nx + 1):
        xi = x[i]
        if xi <= d1:
            idx = 0
        elif xi <= d1 + d2:
            idx = 1
        elif xi <= d1 + d2 + d3:
            idx = 2
        else:
            idx = 3
        rho_arr[i] = rho[idx]
        cp_arr[i] = cp[idx]
        k_arr[i] = kmat[idx]

    T = np.ones(Nx + 1) * T0
    skin_temp = []

    for n in range(Nt):
        A = np.zeros((Nx + 1, Nx + 1))
        b = np.zeros(Nx + 1)

        for i in range(1, Nx):
            k_plus = 2 * k_arr[i] * k_arr[i + 1] / (k_arr[i] + k_arr[i + 1])
            k_minus = 2 * k_arr[i] * k_arr[i - 1] / (k_arr[i] + k_arr[i - 1])
            alpha_plus = k_plus * dt / (rho_arr[i] * cp_arr[i] * dx ** 2)
            alpha_minus = k_minus * dt / (rho_arr[i] * cp_arr[i] * dx ** 2)

            A[i, i - 1] = -alpha_minus / 2
            A[i, i] = 1 + (alpha_plus + alpha_minus) / 2
            A[i, i + 1] = -alpha_plus / 2
            b[i] = (alpha_minus / 2) * T[i - 1] + (1 - (alpha_plus + alpha_minus) / 2) * T[i] + (alpha_plus / 2) * T[
                i + 1]

        # 左边界
        k0 = k_arr[0]
        alpha0 = k0 * dt / (rho_arr[0] * cp_arr[0] * dx ** 2)
        beta1 = h1 * dx / k0
        A[0, 0] = 1 + alpha0 * (1 + beta1)
        A[0, 1] = -alpha0
        b[0] = (1 - alpha0 * (1 + beta1)) * T[0] + alpha0 * T[1] + 2 * alpha0 * beta1 * T_env

        # 右边界
        kN = k_arr[-1]
        alphaN = kN * dt / (rho_arr[-1] * cp_arr[-1] * dx ** 2)
        beta4 = h4 * dx / kN
        A[Nx, Nx - 1] = -alphaN
        A[Nx, Nx] = 1 + alphaN * (1 + beta4)
        b[Nx] = alphaN * T[Nx - 1] + (1 - alphaN * (1 + beta4)) * T[Nx] + 2 * alphaN * beta4 * T_body

        T = np.linalg.solve(A, b)
        skin_temp.append(T[-1])

    return np.array(skin_temp)


def get_metrics_3(d2, d4):
    T = solve_temperature_3(d2, d4)
    Tmax = np.max(T)
    tau = np.sum(T > 44.0) * dt
    return Tmax, tau


# =========================================================================
# 三、 重构后的双变量无量纲指标函数与综合效用函数
# =========================================================================
def comfort_v3(d2, d4):
    # 空间舒适度：两层总厚度越厚，得分越低 (由1递减到0)
    L_total = d2 + d4
    x = (L_total - L_min) / (L_max - L_min)
    return 1.0 - np.sqrt(x)


def safety_score_v3(d2, d4):
    # 本征热阻效用：计算 II 层和 IV 层的串联综合物理热阻
    R_total = (d2 / kmat[1]) + (d4 / kmat[3])

    # 计算空间边界下的极限热阻，用于标准的无量纲归一化
    R_min = (d_min_layer / kmat[1]) + (d_min_layer / kmat[3])
    R_max = (d_max_1_layer / kmat[1]) + (d_max_2_layer / kmat[3])

    # 归一化映射：系统热阻越大，安全效用越高 (由0递增到1)
    S = (R_total - R_min) / (R_max - R_min)
    return S


def objective_function(x_vars):
    """
    梯度优化目标函数。因为 scipy 默认执行的是【最小化】，
    为了实现【最大化效用 U】，我们直接给综合效用加上一个【负号】。
    """
    d2, d4 = x_vars[0], x_vars[1]

    # 1. 提取舒适度与安全得分
    X = comfort_v3(d2, d4)
    Y = safety_score_v3(d2, d4)

    # 边界保护
    if X <= 0 or Y <= 0:
        return 1e9  # 返回一个巨大的正惩罚项

    # 2. 柯布-道格拉斯效用合成
    U = (X ** alpha_pref) * (Y ** (1 - alpha_pref))
    return -U  # 加负号：最小化 -U 等价于 最大化 U


# =========================================================================
# 四、 刚性约束条件拦截器 (配合 SLSQP 梯度算法)
# =========================================================================
def constraint_temperature(x_vars):
    # 约束 1：30分钟皮肤外侧最高温度不超过 47℃ (SLSQP 要求返回格式 >= 0)
    d2, d4 = x_vars[0], x_vars[1]
    Tmax, _ = get_metrics_3(d2, d4)
    return 47.0 - Tmax  # 47 - Tmax >= 0  => Tmax <= 47


def constraint_time(x_vars):
    # 约束 2：超过 44℃ 的累计时间不超过 5分钟 (300秒)
    d2, d4 = x_vars[0], x_vars[1]
    _, tau = get_metrics_3(d2, d4)
    return 300.0 - tau  # 300 - tau >= 0  => tau <= 300


# =========================================================================
# 五、 激活 SLSQP 连续梯度搜索求解器
# =========================================================================
print("=" * 60)
print("正在激活 SLSQP 序贯二次规划算法进行二维梯度空间寻优...")
print("=" * 60)

# 1. 设定猜测初始点 (从比较厚、绝对安全的保守位置开始下山)
x0 = [0.015, 0.015]

# 2. 组装决策变量的物理边界限制盒
bounds = [(d_min_layer, d_max_1_layer), (d_min_layer, d_max_2_layer)]

# 3. 组装非线性硬约束字典
constraints = [
    {'type': 'ineq', 'fun': constraint_temperature},
    {'type': 'ineq', 'fun': constraint_time}
]

# 4. 运行单目标梯度优化引擎
res = minimize(
    objective_function,
    x0,
    method='SLSQP',
    bounds=bounds,
    constraints=constraints,
    options={'disp': True, 'ftol': 1e-5}
)

# =========================================================================
# 六、 黄金决策点物理与生物指标复原输出
# =========================================================================
if res.success:
    d2_opt_mm = res.x[0] * 1000
    d4_opt_mm = res.x[1] * 1000
    U_max = -res.fun

    # 还原最终状态
    Tmax_final, tau_final = get_metrics_3(res.x[0], res.x[1])
    C_final = comfort_v3(res.x[0], res.x[1])
    R_final = safety_score_v3(res.x[0], res.x[1])
    final_mass = rho[1] * res.x[0] + rho[3] * res.x[1]

    print("\n" + "=" * 60)
    print("【SLSQP 梯度优化搜索成功！】")
    print(f"最优 II 层织物厚度 d2* = {d2_opt_mm:.4f} mm")
    print(f"最优 IV 层空气厚度 d4* = {d4_opt_mm:.4f} mm")
    print("-" * 50)
    print(f"最大综合效用得分 U* = {U_max:.6f}")
    print(f"此时的空间舒适度 C = {C_final:.4f}")
    print(f"此时的本征安全度 R = {R_final:.4f}")
    print(f"最终皮肤最高温度 = {Tmax_final:.2f} ℃ (限值 47℃)")
    print(f"最终超44℃累计时间 = {tau_final:.2f} 秒 (限值 300秒)")
    print(f"防护服对应面质量负荷 = {final_mass:.4f} kg/m²")
    print("=" * 60)
else:
    print("优化失败，算法未能成功收敛。请检查初始猜测点 x0 或约束边界。")

