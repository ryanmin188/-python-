import numpy as np
import matplotlib.pyplot as plt

# =========================================================
# 高温作业服热传导模型（正确版）
# 变系数 Crank–Nicolson
#
# 修复内容：
# 1. 正确处理多层材料
# 2. 正确处理界面热流连续
# 3. 使用调和平均导热系数
# 4. 正确反求临界 d2
#
# 目标：
# T(55min)=44℃
# =========================================================

# =========================================================
# 一、物理参数
# =========================================================

T_env = 65.0
T_body = 37.0
T0 = 37.0

# 各层厚度（m）
d1 = 0.0006
d3 = 0.0036
d4 = 0.0055

# 热物性参数
#           I       II      III      IV
rho = [300,   862,   74.2,    1.18]
c    = [1377, 2100,  1726,    1005]
kmat = [0.082,0.37,  0.045,   0.028]

# 对流换热系数
h1 = 113.0
h4 = 8.344

# =========================================================
# 二、数值参数
# =========================================================

dt = 1.0

t_end = 60 * 60
Nt = int(t_end / dt)

Nx = 220

# =========================================================
# 三、PDE求解器
# =========================================================

def solve_temperature(d2):

    # -----------------------------------------------------
    # 总厚度
    # -----------------------------------------------------

    L = d1 + d2 + d3 + d4

    dx = L / Nx

    x = np.linspace(0, L, Nx + 1)

    # -----------------------------------------------------
    # 空间参数
    # -----------------------------------------------------

    rho_arr = np.zeros(Nx + 1)
    c_arr   = np.zeros(Nx + 1)
    k_arr   = np.zeros(Nx + 1)

    # -----------------------------------------------------
    # 材料分层
    # -----------------------------------------------------

    for i in range(Nx + 1):

        xi = x[i]

        if xi <= d1:

            idx = 0

        elif xi <= d1 + d2:

            idx = 1

        elif xi <= d1 + d2 + d3:

            idx = 2

        else:

            idx = 3

        rho_arr[i] = rho[idx]
        c_arr[i]   = c[idx]
        k_arr[i]   = kmat[idx]

    # -----------------------------------------------------
    # 初始温度
    # -----------------------------------------------------

    T = np.ones(Nx + 1) * T0

    skin_temp = []

    # =====================================================
    # 时间推进
    # =====================================================

    for n in range(Nt):

        A = np.zeros((Nx + 1, Nx + 1))
        b = np.zeros(Nx + 1)

        # =================================================
        # 内部节点
        # =================================================

        for i in range(1, Nx):

            # ------------------------------------------------
            # 调和平均导热系数
            # ------------------------------------------------

            k_plus = (
                2 * k_arr[i] * k_arr[i+1]
                / (k_arr[i] + k_arr[i+1])
            )

            k_minus = (
                2 * k_arr[i] * k_arr[i-1]
                / (k_arr[i] + k_arr[i-1])
            )

            alpha_plus = (
                k_plus * dt
                / (rho_arr[i] * c_arr[i] * dx**2)
            )

            alpha_minus = (
                k_minus * dt
                / (rho_arr[i] * c_arr[i] * dx**2)
            )

            # ------------------------------------------------
            # Crank-Nicolson
            # ------------------------------------------------

            A[i, i-1] = -alpha_minus / 2

            A[i, i] = (
                1
                + (alpha_plus + alpha_minus) / 2
            )

            A[i, i+1] = -alpha_plus / 2

            b[i] = (
                (alpha_minus / 2) * T[i-1]
                + (
                    1
                    - (alpha_plus + alpha_minus) / 2
                ) * T[i]
                + (alpha_plus / 2) * T[i+1]
            )

        # =================================================
        # 左边界（环境侧）
        # 对流边界
        # =================================================

        k0 = k_arr[0]

        alpha0 = (
            k0 * dt
            / (rho_arr[0] * c_arr[0] * dx**2)
        )

        beta1 = h1 * dx / k0

        A[0,0] = 1 + alpha0 * (1 + beta1)
        A[0,1] = -alpha0

        b[0] = (
            (1 - alpha0 * (1 + beta1)) * T[0]
            + alpha0 * T[1]
            + 2 * alpha0 * beta1 * T_env
        )

        # =================================================
        # 右边界（人体侧）
        # =================================================

        kN = k_arr[-1]

        alphaN = (
            kN * dt
            / (rho_arr[-1] * c_arr[-1] * dx**2)
        )

        beta4 = h4 * dx / kN

        A[Nx, Nx-1] = -alphaN

        A[Nx, Nx] = (
            1 + alphaN * (1 + beta4)
        )

        b[Nx] = (
            alphaN * T[Nx-1]
            + (
                1
                - alphaN * (1 + beta4)
            ) * T[Nx]
            + 2 * alphaN * beta4 * T_body
        )

        # =================================================
        # 求解线性方程组
        # =================================================

        T = np.linalg.solve(A, b)

        skin_temp.append(T[-1])

    return np.array(skin_temp)

# =========================================================
# 四、目标函数
# g(d2)=T(55min)-44
# =========================================================

def objective(d2):

    skin_temp = solve_temperature(d2)

    idx55 = int(55 * 60 / dt)

    T55 = skin_temp[idx55]

    return T55 - 44

# =========================================================
# 五、二分法搜索
# =========================================================

low = 0.001
high = 0.03

tol = 1e-5

iteration = 0

print("="*60)
print("开始搜索临界 d2")
print("="*60)

while high - low > tol:

    iteration += 1

    mid = (low + high) / 2

    value = objective(mid)

    T55 = value + 44

    print(
        f"Iter {iteration:02d} | "
        f"d2 = {mid*1000:.3f} mm | "
        f"T55 = {T55:.4f} ℃"
    )

    # 温度过高
    if value > 0:

        low = mid

    # 温度偏低
    else:

        high = mid

# =========================================================
# 六、最终结果
# =========================================================

d2_star = (low + high) / 2

skin_temp_star = solve_temperature(d2_star)

Tmax = np.max(skin_temp_star)

t44 = np.sum(skin_temp_star > 44) * dt

print("\n")
print("="*60)
print("搜索完成")
print("="*60)

print(f"临界厚度 d2* = {d2_star*1000:.4f} mm")

print(f"最大温度 Tmax = {Tmax:.4f} ℃")

print(f"超44℃时间 t44 = {t44:.1f} s")

print("="*60)

# =========================================================
# 七、绘图
# =========================================================

time = np.arange(0, t_end, dt) / 60

plt.figure(figsize=(10,6))

plt.plot(
    time,
    skin_temp_star,
    linewidth=2,
    label='Skin Temperature'
)

plt.axhline(
    44,
    linestyle='--',
    label='44℃'
)

plt.axvline(
    55,
    linestyle='--',
    label='55 min'
)

plt.xlabel("Time (min)")
plt.ylabel("Temperature (℃)")
plt.title("Critical d2 by Variable-Coefficient Crank-Nicolson")

plt.grid(True)
plt.legend()

plt.show()
